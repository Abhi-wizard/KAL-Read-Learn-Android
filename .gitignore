# ====================================================================
# KAL Android Application - .gitignore
# ====================================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
*/build/
app/build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk.dir, etc)
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Node & Firebase Cloud Functions
node_modules/
*/node_modules/
functions/lib/
functions/node_modules/
*.log
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Environment & Secrets (NEVER commit live API keys)
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example

# Android Keystores & Signing
*.jks
*.keystore
keystore.properties
signing.properties

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk
